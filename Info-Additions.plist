<?xml version="1.0" encoding="UTF-8"?>
<!--
  These are NOT a full Info.plist — just the entries this app needs.
  In a project generated by Xcode's "App" template, Info.plist is usually
  managed under Target > Info tab rather than as a standalone file, so the
  easiest path is to add these two rows there directly:

    Privacy - Camera Usage Description
      → "O Herbário usa a câmera para fotografar plantas e identificá-las."

    Privacy - Photo Library Usage Description
      → "O Herbário acessa suas fotos para identificar plantas já fotografadas."

  If your project does use a standalone Info.plist file, merge the two
  <key>/<string> pairs below into its <dict>.
-->
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>O Herbário usa a câmera para fotografar plantas e identificá-las.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>O Herbário acessa suas fotos para identificar plantas já fotografadas.</string>
</dict>
</plist>
